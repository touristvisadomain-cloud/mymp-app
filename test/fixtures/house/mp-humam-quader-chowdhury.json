{"version":"2026-10-10T08:58:17.257Z","lang":"bn","id":"013028401","slug":"humam-quader-chowdhury","nameBn":"হুমাম কাদের চৌধুরী","nameEn":"Humam Quader Chowdhury","photoUrl":"https://prp.parliament.gov.bd/api/files?_=MjAyNjAyMTYvcDIyMDE4MDEyX2FiN2U3NTQ5ODAxZjQ2MmY4MmUxMzU4NTAwNGM4MGZiLmpwZw==","gender":"Male","party":"BNP","partyBn":"বিএনপি","seatNo":284,"seatBn":"চট্টগ্রাম-৭","seatSlug":"chattogram-7","seatEn":"Chattogram-7","districtBn":"চট্টগ্রাম","districtEn":"Chattogram","districtSlug":"chattogram","areaBn":"(ক) রাংগুনিয়া উপজেলা (খ) বোয়ালখালী উপজেলার শ্রীপুর-খরনদ্বীপ ইউনিয়ন।","officeBn":null,"reserved":false,"professionBn":null,"educationBn":null,"birthPlaceBn":null,"dateOfBirth":"1983-06-23","fatherBn":"সালা উদ্দীন কাদের চৌধুরী","motherBn":"ফারহাত কাদের চৌধুরী","isFreedomFighter":false,"email":"chittagong.7@parliament.gov.bd","bioBn":"হুমাম কাদের চৌধুরী ত্রয়োদশ জাতীয় সংসদে চট্টগ্রাম-৭ (রাঙ্গুনিয়া উপজেলা ও বোয়ালখালীর শ্রীপুর-খরনদ্বীপ ইউনিয়ন) আসনের সংসদ সদস্য। বাংলাদেশ জাতীয়তাবাদী দল (বিএনপি) থেকে তিনি প্রথমবারের মতো সংসদে এসেছেন। সংসদে তিনি পররাষ্ট্র মন্ত্রণালয় সম্পর্কিত স্থায়ী কমিটি ও লাইব্রেরি কমিটির সদস্য এবং লাইব্রেরি কমিটির সাব-কমিটি নং-১ এর সভাপতি।\n\nহুমাম কাদের চৌধুরী ১৯৮৩ সালের ২৩ জুন একটি রাজনৈতিক পরিবারে জন্মগ্রহণ করেন। তাঁর পিতা সালাউদ্দিন কাদের চৌধুরী ছিলেন বিএনপির স্থায়ী কমিটির সদস্য এবং চট্টগ্রামের বিভিন্ন আসন থেকে নির্বাচিত সংসদ সদস্য। মাতা ফারহাত কাদের চৌধুরী।\n\nপারিবারিক রাজনৈতিক ধারাবাহিকতায় তিনি বিএনপির রাজনীতিতে সক্রিয় হন এবং চট্টগ্রাম অঞ্চলে দলীয় কার্যক্রমের মাধ্যমে পরিচিতি লাভ করেন। তিনি বিএনপির কেন্দ্রীয় নির্বাহী কমিটির সদস্য।\n\n১২ ফেব্রুয়ারি ২০২৬ অনুষ্ঠিত ত্রয়োদশ জাতীয় সংসদ নির্বাচনে তিনি বিএনপির প্রার্থী হিসেবে ধানের শীষ প্রতীকে ১,০১,৪৪৫ ভোট পেয়ে চট্টগ্রাম-৭ আসন থেকে সংসদ সদস্য নির্বাচিত হন।","bioTranslated":false,"bioOnlyInBangla":false,"summaryBn":null,"summaryTranslated":false,"showSummary":false,"leadBn":"হুমাম কাদের চৌধুরী চট্টগ্রাম-৭ আসন থেকে নির্বাচিত ত্রয়োদশ জাতীয় সংসদের সদস্য এবং বাংলাদেশ জাতীয়তাবাদী দলের সংসদ সদস্য। এই পাতায় তাঁর পরিচিতি, নির্বাচনী ফলাফল, আগের মেয়াদ, সংসদীয় কমিটি ও যোগাযোগের তথ্য রয়েছে।","introBn":[],"bioSource":null,"bioSources":["https://bn.wikipedia.org/wiki/%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%BE%E0%A6%AE_%E0%A6%95%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0_%E0%A6%9A%E0%A7%8C%E0%A6%A7%E0%A7%81%E0%A6%B0%E0%A7%80","https://en.wikipedia.org/wiki/Humam_Quader_Chowdhury","https://www.thedailystar.net/news/national-election-2026/news/feb-12-elections-four-bnp-leaders-sons-enter-ctg-race-banking-family-legacy-4097111","https://www.tbsnews.net/election-2026-seat/chattogram-7"],"bioSourceLinks":[{"url":"https://bn.wikipedia.org/wiki/%E0%A6%B9%E0%A7%81%E0%A6%AE%E0%A6%BE%E0%A6%AE_%E0%A6%95%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B0_%E0%A6%9A%E0%A7%8C%E0%A6%A7%E0%A7%81%E0%A6%B0%E0%A7%80","label":"উইকিপিডিয়া (বাংলা)"},{"url":"https://en.wikipedia.org/wiki/Humam_Quader_Chowdhury","label":"উইকিপিডিয়া (ইংরেজি)"},{"url":"https://www.thedailystar.net/news/national-election-2026/news/feb-12-elections-four-bnp-leaders-sons-enter-ctg-race-banking-family-legacy-4097111","label":"thedailystar.net"},{"url":"https://www.tbsnews.net/election-2026-seat/chattogram-7","label":"tbsnews.net"}],"bioFromWiki":null,"term":{"start":"2026-02-17","end":"2031-02-16"},"termsCount":1,"status":"Active","resignedOn":null,"partyRoleBn":null,"ministryBn":null,"partyNameBn":"বাংলাদেশ জাতীয়তাবাদী দল (বি.এন.পি)","seat":{"no":284,"slug":"chattogram-7","nameBn":"চট্টগ্রাম-৭","reserved":false,"districtSlug":"chattogram","districtBn":"চট্টগ্রাম","boundaryBn":"(ক) রাংগুনিয়া উপজেলা (খ) বোয়ালখালী উপজেলার শ্রীপুর-খরনদ্বীপ ইউনিয়ন।","boundaryTranslated":false,"vacantSince":null},"offices":[],"rolesBn":[],"postBadgesBn":[],"postsCheckedAt":"2026-10-08T03:17:44.556+00:00","socials":[{"key":"facebook","icon":"facebook","url":"https://www.facebook.com/humamquaderchy","unverified":true,"label":"ফেসবুক পেজ"}],"facebookNotice":null,"socialSource":null,"governmentPosts":[],"committees":[{"slug":"library-committee","nam