{"version":"2026-10-10T08:58:17.257Z","lang":"bn","id":"013000701","slug":"md-sadique-reaz","nameBn":"মোঃ সাদিক রিয়াজ","nameEn":"Md Sadique Reaz","photoUrl":"https://prp.parliament.gov.bd/api/files?_=MjAyNjAyMTQvcDIyMDE3NDA0X2M5NWM3NzZmOTZlOTQyMmE4YzBlMzhmYmE4ZjYxNDc1LmpwZw==","gender":"Male","party":"BNP","partyBn":"বিএনপি","seatNo":7,"seatBn":"দিনাজপুর-২","seatSlug":"dinajpur-2","seatEn":"Dinajpur-2","districtBn":"দিনাজপুর","districtEn":"Dinajpur","districtSlug":"dinajpur","areaBn":"(ক)বোচাগঞ্জ এবং(খ) বিরল উপজেলা","officeBn":null,"reserved":false,"professionBn":"ব্যবসায়ী","educationBn":"বাণিজ্যে স্নাতকোত্তর","birthPlaceBn":"দৌলা, বোচাগঞ্জ, দিনাজপুর","dateOfBirth":"1965-12-20","fatherBn":"এ এফ এম রিয়াজুল হক চৌধুরী","motherBn":"মিসেস সুরাইয়া রিয়াজ","isFreedomFighter":false,"email":"dinajpur.2@parliament.gov.bd","bioBn":"মোঃ সাদিক রিয়াজ (সাদিক রিয়াজ চৌধুরী পিনাক) ত্রয়োদশ জাতীয় সংসদে দিনাজপুর-২ (বোচাগঞ্জ ও বিরল) আসনের সংসদ সদস্য। বাংলাদেশ জাতীয়তাবাদী দল (বিএনপি) থেকে তিনি প্রথমবারের মতো সংসদে এসেছেন। ১৯৬৫ সালের ২০ ডিসেম্বর তিনি দিনাজপুর জেলার বোচাগঞ্জ উপজেলার দৌলা গ্রামে জন্মগ্রহণ করেন। তাঁর পিতা এ এফ এম রিয়াজুল হক চৌধুরী এবং মাতা সুরাইয়া রিয়াজ। তিনি বাণিজ্য বিভাগে স্নাতকোত্তর ডিগ্রি অর্জন করেছেন এবং পেশায় ব্যবসায়ী।\n\nসাদিক রিয়াজ দীর্ঘদিন ধরে দিনাজপুর জেলার রাজনীতির সঙ্গে যুক্ত। জেলা বিএনপির নির্বাহী সদস্য হিসেবে তিনি দলীয় কার্যক্রমে সক্রিয় ভূমিকা পালন করেছেন। একাদশ জাতীয় সংসদ নির্বাচনেও তিনি দিনাজপুর-২ আসনে বিএনপির মনোনীত প্রার্থী ছিলেন। ১২ ফেব্রুয়ারি ২০২৬ অনুষ্ঠিত ত্রয়োদশ জাতীয় সংসদ নির্বাচনে তিনি ধানের শীষ প্রতীকে ১,৩৯,৬২২ ভোট পেয়ে সংসদ সদস্য নির্বাচিত হন।","bioTranslated":false,"bioOnlyInBangla":false,"summaryBn":null,"summaryTranslated":false,"showSummary":false,"leadBn":"মোঃ সাদিক রিয়াজ দিনাজপুর-২ আসন থেকে নির্বাচিত ত্রয়োদশ জাতীয় সংসদের সদস্য এবং বাংলাদেশ জাতীয়তাবাদী দলের সংসদ সদস্য। এই পাতায় তাঁর পরিচিতি, নির্বাচনী ফলাফল, আগের মেয়াদ, সংসদীয় কমিটি ও যোগাযোগের তথ্য রয়েছে।","introBn":[],"bioSource":"https://bn.wikipedia.org/wiki/%E0%A6